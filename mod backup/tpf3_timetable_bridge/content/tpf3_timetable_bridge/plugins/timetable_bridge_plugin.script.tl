-- TPF3 Timetable Bridge — UI plugin.
--
-- Responsibilities (the game-script context cannot do file IO: `app` is
-- `false` there — verified on 2026-09-30):
--
--   1. EXPORT: dump stations / lines / lineStops from the loaded game to
--      userdata/towns_industries/tpf3_timetable_bridge_export.lua. (TPF3
--      replacement for the old TPF2 `idget` mod export.)
--
--   2. PUSH: load userdata/towns_industries/tpf3_timetable_bridge_data.lua
--      (generated by the desktop tool) and broadcast it as the "autofill_data" event
--      (id="AutoFillBridge") — only when the user clicks 应用数据文件 in the
--      AutoFill window (no automatic apply). The bridge game script applies
--      the data via celmi_timetables' public "TimetablesEdit" event channel.
--
--   3. PROBE: answer the desktop tool's "refresh" probe (probe.lua →
--      probe_result.lua) with the current save name and timetable cycle.
--
--   4. UI: a small "AutoFill" button in the game bar opens a window with
--      the import status and two buttons (apply now / re-export data).
--
-- Execution notes: react timer callbacks run with restricted APIs and
-- must not call api.cmd / api.gui; the poll therefore hops to the
-- main-thread join (react.enqueueJoin) and waits until no savegame is
-- being loaded or saved.

local record AppFileApi
    saveUserdata : function(string, string, table) : any
    loadUserdata : function(string, string) : table
    getAllUserdata : function(string) : {string}
end

local record Wrapped
    data : any
end

local record DataHeader
    revision : any
    force : any
    lines : any
end

local record ProbeRequest
    token : any
end

local record GsComponent
    state : any
end

local record GsState
    lastApply : any
    rosterLogged : any
    appliedRevision : any
end

local record CelmiState
    cycleSec : any
end

local record ReportLine
    name : string
    stops : integer
    slots : integer
    found : boolean
end

local record Report
    revision : any
    force : any
    applied : any
    totalLines : any
    totalStops : any
    totalSlots : any
    cleared : any
    lines : {ReportLine} | nil
end

local record StatusSnap
    dataFound : boolean
    dataRevision : any
    dataLines : any
    dataForce : any
    exportLines : any
    appliedRevision : any
    report : Report | nil
end

local record GameReactGlobalsApi
    getDefaultWindowApi : function() : any
end

local record WindowApi
    addSingletonWindow : function(any, any) : any
    removeAllWindows : function(any) : any
end

local react = ug_require "::/gui/main/react.lua" as React
local builtin = ug_require "::/gui/main/builtin.lua" as Builtin
local game_react_globals = ug_require "::/gui/main/game_react_globals.tl" as GameReactGlobalsApi
local game_bar_widgets = ug_require "::/gui/game_bar/game_bar_widgets.tl" as GameBarWidgets
local engine_react_util = ug_require "::/gui/main/engine_react_util.tl" as EngineReactUtil
local lang_util = ug_require "::/scripts/lang_util.tl" as LangUtil

-- Since game build 40420 (2026-10) the script file API only accepts
-- towns_industries / biomes / heightmaps / mod_presets as userdata folders.
-- The bridge therefore exchanges files through towns_industries, with a
-- distinctive file-name prefix so they cannot be mistaken for map-editor data.
local EXCHANGE_DIR : string = "towns_industries"
local FILE_PREFIX : string = "tpf3_timetable_bridge_"
local GS_PATH : string = "tpf3_timetable_bridge::/tpf3_timetable_bridge/game_script/tpf3_timetable_bridge.gs"
local CELMI_GS_PATH : string = "celmi_timetables::/timetable/game_script/celmi_timetables.gs"
local POLL_SEC : number = 1.0
local RESENDS : integer = 3

-- Per-session module state.
local pendingPayload : any = nil
local pendingSends : integer = 0
local pollCounter : integer = 0
-- Cached listing of the exchange folder. Reading a userdata file that does not
-- exist makes the engine log a warning on every poll, so check the listing first.
local exchangeList : {string : boolean} = {}
local exchangeListPoll : integer = -1
local exportWorld : Engine.Entity | nil = nil
local warnedMissingData : boolean = false
local requestApply : boolean = false
local requestExport : boolean = false
-- Display cache (updated by poll, read by the window).
local lastExportLines : any = nil
local dataFound : boolean = false
local dataRevision : any = nil
local dataLines : any = nil
local dataForce : any = nil
local lastReport : Report | nil = nil
local lastReportSig : string = ""
local warnedReportError : boolean = false
local reportProbeSig : string = ""
local lastAppliedRevision : any = nil
local lastProbeToken : any = nil
-- Window bookkeeping.
local windowIsOpen : boolean = false
local windowApiInUse : any = nil

-- helpers ------------------------------------------------------------

local function files() : AppFileApi | nil
    local a : any = app
    if type(a) == "table" then
        return a as AppFileApi
    end
    return nil
end

-- Refresh the cached exchange-folder listing (at most once per poll).
local function refreshExchangeList()
    local fa : AppFileApi | nil = files()
    if fa == nil then return end
    local ok, list = pcall(function() : any
        return (fa as AppFileApi).getAllUserdata(EXCHANGE_DIR)
    end)
    exchangeList = {}
    if not ok or type(list) ~= "table" then return end
    for _, n in pairs(list as {any}) do
        if type(n) == "string" then
            exchangeList[n as string] = true
        end
    end
end

-- Does <prefix><name>.lua exist in the exchange folder?
-- (getAllUserdata may return bare names, names with .lua, or full paths.)
local function exchangeHas(name : string) : boolean
    if exchangeListPoll ~= pollCounter then
        exchangeListPoll = pollCounter
        refreshExchangeList()
    end
    local target : string = FILE_PREFIX .. name
    for k in pairs(exchangeList) do
        local pos = string.find(k, target, 1, true)
        if pos ~= nil then
            local after : string = k:sub(pos + #target, pos + #target)
            if after == "" or after == "." then
                return true
            end
        end
    end
    return false
end

local function nameOf(e : Engine.Entity) : string
    if e == nil then return "" end
    if (e as integer) <= 0 then return "" end
    local n = api.engine.getComponent(e, api.type.ComponentType.NAME) as Engine.Component.Name
    if n ~= nil and n.name ~= nil then return n.name end
    return ""
end

-- Current timetable cycle (seconds) from the Timetables mod's own state,
-- so export.lua can tell the desktop tool what this save is set to.
local function readCelmiCycle() : any
    local ok, res = pcall(function() : any
        local entity = api.engine.system.gameScriptSystem.getEntityForGameScript(CELMI_GS_PATH)
        if entity == nil or (entity as integer) <= 0 then return nil end
        local gs : any = api.engine.getComponent(entity, api.type.ComponentType.GAME_SCRIPT)
        if gs == nil then return nil end
        local st : any = (gs as GsComponent).state
        if st == nil then return nil end
        return (st as CelmiState).cycleSec
    end)
    if not ok then return nil end
    return res
end

-- Best-effort current save identity (probe for the desktop tool's future
-- save matching; logged so we can see what the engine actually returns).
local function readSaveId() : any
    local ok, res = pcall(function() : any
        return api.gui.game.getDefaultSavegameId()
    end)
    if not ok then return nil end
    if type(res) == "string" and res ~= "" then return res end
    return nil
end

local function writeExport()
    local fa : AppFileApi | nil = files()
    if fa == nil then return end
    local f : AppFileApi = fa as AppFileApi

    -- NOTE: the engine's userdata serialiser drops tables whose keys are
    -- not strings (verified 2026-09-30: integer-keyed maps came out as
    -- empty tables), so everything is string-keyed and the stop lists are
    -- comma-joined strings.
    local stations : {string : string} = {}
    local lines : {string : string} = {}
    local lineStops : {string : string} = {}

    local allLines = api.engine.system.lineSystem.getLines()
    for _, lineEnt in ipairs(allLines) do
        local lineId : integer = lineEnt as integer
        lines[tostring(lineId)] = nameOf(lineEnt)
        local lineComp = api.engine.getComponent(lineEnt, api.type.ComponentType.LINE) as Engine.Component.Line
        local stopStr : string = ""
        if lineComp ~= nil and lineComp.stops ~= nil then
            for _, stop in ipairs(lineComp.stops) do
                local sg : Engine.Entity = stop.stationGroup
                if sg ~= nil and (sg as integer) > 0 then
                    if stopStr ~= "" then
                        stopStr = stopStr .. ","
                    end
                    stopStr = stopStr .. tostring(sg as integer)
                    local sgKey : string = tostring(sg as integer)
                    if stations[sgKey] == nil then
                        stations[sgKey] = nameOf(sg)
                    end
                end
            end
        end
        lineStops[tostring(lineId)] = stopStr
    end

    local saveId = readSaveId()

    f.saveUserdata(EXCHANGE_DIR, FILE_PREFIX .. "export", {
        stations = stations,
        lines = lines,
        lineStops = lineStops,
        cycleSec = readCelmiCycle(),
        saveId = saveId,
    })
    lastExportLines = #allLines
    debugPrint("[AFB-UI] export written (" .. tostring(#allLines) ..
        " line(s), saveId=" .. tostring(saveId) .. ")")
end

local function loadUserdataFile(name : string) : any
    local fa : AppFileApi | nil = files()
    if fa == nil then return nil end
    local f : AppFileApi = fa as AppFileApi
    local raw : any = f.loadUserdata(EXCHANGE_DIR, FILE_PREFIX .. name)
    if type(raw) == "table" then
        local fn : any = (raw as Wrapped).data
        if type(fn) == "function" then
            local call : function() : any = fn as function() : any
            raw = call()
        end
    end
    return raw
end

local function loadData() : any
    if not exchangeHas("data") then return nil end
    return loadUserdataFile("data")
end

-- Desktop-tool "refresh" probe: the tool writes probe.lua carrying a fresh
-- token; answer once per token with the current save name + timetable cycle
-- so the tool can show live values (export.lua may be from an earlier load).
local function answerProbe()
    if not exchangeHas("probe") then return end
    local ok, raw = pcall(function() : any
        return loadUserdataFile("probe")
    end)
    if not ok or type(raw) ~= "table" then return end
    local tok : any = (raw as ProbeRequest).token
    local tokStr : string | nil = nil
    if type(tok) == "string" and tok ~= "" then
        tokStr = tok as string
    end
    if tokStr == nil then return end
    if tokStr == lastProbeToken then return end
    lastProbeToken = tokStr
    local fa : AppFileApi | nil = files()
    if fa == nil then return end
    local saveId = readSaveId()
    local cycleSec = readCelmiCycle()
    (fa as AppFileApi).saveUserdata(EXCHANGE_DIR, FILE_PREFIX .. "probe_result", {
        token = tokStr,
        saveId = saveId,
        cycleSec = cycleSec,
    })
    debugPrint("[AFB-UI] probe answered (token=" .. tokStr ..
        ", saveId=" .. tostring(saveId) .. ", cycleSec=" .. tostring(cycleSec) .. ")")
end

local function readReport() : Report | nil
    local ok, res = pcall(function() : any
        local scanUsed : boolean = false
        local entity = api.engine.system.gameScriptSystem.getEntityForGameScript(GS_PATH)
        if entity == nil or (entity as integer) <= 0 then
            -- Fallback: scan all game-script entities for the one whose
            -- state carries our bridge fields.
            scanUsed = true
            local found : any = nil
            api.engine.forEachEntityWithComponent(function(e : any)
                if found ~= nil then return end
                local g : any = api.engine.getComponent(e as Engine.Entity, api.type.ComponentType.GAME_SCRIPT)
                if g ~= nil then
                    local s2 : any = (g as GsComponent).state
                    if s2 ~= nil then
                        local sst2 = s2 as GsState
                        if sst2.rosterLogged ~= nil or sst2.appliedRevision ~= nil or sst2.lastApply ~= nil then
                            found = e
                        end
                    end
                end
            end, api.type.ComponentType.GAME_SCRIPT)
            if found ~= nil then
                entity = found as Engine.Entity
            end
        end
        local gs : any = nil
        if entity ~= nil and (entity as integer) > 0 then
            gs = api.engine.getComponent(entity, api.type.ComponentType.GAME_SCRIPT)
        end
        local st : any = nil
        if gs ~= nil then
            st = (gs as GsComponent).state
        end
        local r : any = nil
        lastAppliedRevision = nil
        if st ~= nil then
            r = (st as GsState).lastApply
            lastAppliedRevision = (st as GsState).appliedRevision
        end
        local laType : string = "n/a"
        if st ~= nil then
            laType = type((st as GsState).lastApply)
        end
        local sig : string = tostring(entity) .. "/" .. type(gs) .. "/" .. type(st) .. "/" .. laType
        if sig ~= reportProbeSig then
            reportProbeSig = sig
            debugPrint("[AFB-UI] report probe: entity=" .. tostring(entity) ..
                " scan=" .. tostring(scanUsed) ..
                " gsType=" .. type(gs) .. " stateType=" .. type(st) ..
                " lastApplyType=" .. laType)
        end
        if r == nil then return nil end
        return r
    end)
    if not ok then
        if not warnedReportError then
            warnedReportError = true
            debugPrint("[AFB-UI] report read error: " .. tostring(res))
        end
        return nil
    end
    if res == nil then return nil end
    return res as Report
end

local function poll() : any
    -- Never touch file/command APIs while a savegame is loading/saving,
    -- and only when a world actually exists.
    if api.gui.game.isSavegameUIBlocked() then return end
    local world : Engine.Entity | nil = api.engine.util.getWorld()
    if world == nil then return end

    pollCounter = pollCounter + 1

    if requestExport then
        requestExport = false
        exportWorld = nil
    end

    -- 进存档（world 变化）自动导出一次 export.lua（工具的数据来源）；其余时候不写文件
    if world ~= exportWorld then
        exportWorld = world
        writeExport()
    end

    -- 时刻表数据不再自动应用：只有手动点“应用数据文件”时才读取 data.lua 并推送；
    -- 窗口打开时顺带刷新状态缓存（窗口不打开则完全不读 data.lua / 报告）
    local needData : boolean = requestApply or windowIsOpen
    local raw : any = nil
    if needData then
        raw = loadData()
        if type(raw) == "table" then
            local d = raw as DataHeader
            dataFound = true
            dataRevision = d.revision
            dataForce = d.force
            local ls : any = d.lines
            if type(ls) == "table" then
                local arr : {any} = ls as {any}
                dataLines = #arr
            else
                dataLines = 0
            end
        else
            dataFound = false
            if not warnedMissingData then
                warnedMissingData = true
                debugPrint("[AFB-UI] no data file yet (userdata/" .. EXCHANGE_DIR .. "/" .. FILE_PREFIX .. "data.lua)")
            end
        end
    end

    -- 手动应用（窗口按钮）：强制推送当前 data.lua
    if requestApply then
        requestApply = false
        if type(raw) == "table" then
            local d = raw as DataHeader
            d.force = true
            pendingPayload = raw
            pendingSends = RESENDS
            debugPrint("[AFB-UI] manual apply queued (revision=" .. tostring(d.revision) .. ")")
        else
            debugPrint("[AFB-UI] manual apply ignored: no data.lua")
        end
    end

    if pendingSends > 0 and pendingPayload ~= nil then
        local ok, err = pcall(function() : any
            api.cmd.sendCommand(
                api.cmd.makeScriptingSendEventCmd("", "AutoFillBridge", "autofill_data", pendingPayload))
            return nil
        end)
        if ok then
            pendingSends = pendingSends - 1
            debugPrint("[AFB-UI] data sent (resends left: " .. tostring(pendingSends) .. ")")
        else
            debugPrint("[AFB-UI] data send failed: " .. tostring(err))
            pendingSends = 0
        end
    end

    -- Answer desktop-tool probe requests (live save name + cycle).
    -- (Lightweight: reads only the tiny probe.lua when the tool asks.)
    answerProbe()

    -- Only read the game script's report while the window is open (the getter
    -- reads this cache; when the window is closed we skip the reads entirely).
    -- NOTE: nil clears the cache — the game script wipes its report at the
    -- start of every session, so a saved-and-reloaded game does not show a
    -- previous session's log.
    if windowIsOpen then
        local rep = readReport()
        lastReport = rep
        local sig : string = ""
        if rep ~= nil then
            local r : Report = rep as Report
            sig = tostring(r.revision) .. "/" .. tostring(r.applied) .. "/" ..
                tostring(r.totalStops) .. "/" .. tostring(r.totalSlots)
        end
        if sig ~= lastReportSig then
            lastReportSig = sig
            if sig == "" then
                debugPrint("[AFB-UI] report cleared")
            else
                debugPrint("[AFB-UI] report updated (" .. sig .. ")")
            end
        end
    end
end

-- status window ------------------------------------------------------

local function buildStatus() : StatusSnap
    return {
        dataFound = dataFound,
        dataRevision = dataRevision,
        dataLines = dataLines,
        dataForce = dataForce,
        exportLines = lastExportLines,
        appliedRevision = lastAppliedRevision,
        report = lastReport,
    }
end

local function makeButtons() : any
    return builtin.BoxLayout{
        orientation = builtin.type.Orientation.Horizontal,
        children = {
            builtin.Button{
                meta = { tooltip = _("Apply the data synced from the external program to the timetables") },
                content = builtin.TextView{ text = _("Apply Imported Data to Timetables") },
                onClick = function()
                    requestApply = true
                    debugPrint("[AFB-UI] manual apply requested")
                end,
            },
            builtin.Button{
                meta = { tooltip = _("If the save has changes, export first, then re-sync the station/line data in the external program") },
                content = builtin.TextView{ text = _("Export Save Station/Line Data") },
                onClick = function()
                    requestExport = true
                    debugPrint("[AFB-UI] manual export requested")
                end,
            },
        },
    }
end

local function buildWindowContent(status : StatusSnap) : TreeNodeId
    local children : {any} = {}

    -- Intro（无标题；每行都短到窗口宽度内放得下，文案在 strings.json 里按语言切换）
    local function bodyLine(t : string)
        table.insert(children, builtin.TextView{
            meta = { class = "font-scale-body" },
            text = t,
        })
    end
    bodyLine(_("This mod imports timetables from external Excel/CSV files."))
    bodyLine(_("It currently supports celmi's Timetables mod."))
    bodyLine(_("The game cannot read external data directly,"))
    bodyLine(_("so a companion desktop program is required:"))
    bodyLine("https://github.com/zm0423/tpf2_autofill")
    bodyLine(_("See the program description for details."))
    -- 仅中文版显示的一行（英文译为空白，空则不显示）
    local bili : string = _("也可访问b站用户“今天学高代了吗”的主页，下载或了解教程。")
    if bili ~= "" then
        bodyLine(bili)
    end
    bodyLine(_("Entering a save automatically exports the game data once."))
    bodyLine(_("Applying the timetable requires clicking the button below."))
    table.insert(children, builtin.TextView{ text = "" })

    -- Log area (this game session only).
    table.insert(children, builtin.TextView{
        meta = { class = "font-scale-annotation" },
        text = _("Import log (this session)"),
    })
    local logLines : {any} = {}
    local report : Report | nil = status.report
    if report ~= nil then
        local r : Report = report as Report
        table.insert(logLines, builtin.TextView{ text = lang_util.format(
            _("Imported {applied}/{lines} lines · {stops} stops · {slots} slots (data revision {revision})"),
            { applied = tostring(r.applied), lines = tostring(r.totalLines),
              stops = tostring(r.totalStops), slots = tostring(r.totalSlots),
              revision = tostring(r.revision) }) })
        if r.cleared ~= nil and r.cleared ~= 0 then
            table.insert(logLines, builtin.TextView{ text = lang_util.format(
                _("Cleared {count} line(s)"),
                { count = tostring(r.cleared) }) })
        end
        local linesArr : {ReportLine} | nil = r.lines
        if linesArr ~= nil then
            local arr : {ReportLine} = linesArr as {ReportLine}
            local markMissing : string = _("✗ not found")
            local lineTemplate : string = _("· {name}: {stops} stops / {slots} slots {mark}")
            for _, ln in ipairs(arr) do
                local mark : string = markMissing
                if ln.found then mark = "✓" end
                table.insert(logLines, builtin.TextView{ text = lang_util.format(
                    lineTemplate,
                    { name = ln.name, stops = tostring(ln.stops),
                      slots = tostring(ln.slots), mark = mark }) })
            end
        end
    else
        table.insert(logLines, builtin.TextView{ text = _("(No imports yet in this session)") })
    end
    table.insert(children, builtin.ScrollArea{
        meta = { class = "afb-logscroll" },
        content = builtin.Component{
            meta = { class = "afb-logbox" },
            layout = builtin.BoxLayout{
                orientation = builtin.type.Orientation.Vertical,
                children = logLines,
            },
        },
        horizontalPolicy = builtin.type.ScrollBarPolicy.AlwaysOff,
        verticalPolicy = builtin.type.ScrollBarPolicy.AsNeeded,
    })

    -- Compact status lines.
    if status.dataFound then
        local forceText : string = _("force=no")
        if status.dataForce == true then forceText = _("force=yes") end
        local appliedText : string = ""
        if status.appliedRevision == nil then
            appliedText = _(" · not applied yet")
        elseif tostring(status.appliedRevision) == tostring(status.dataRevision) then
            appliedText = _(" · applied")
        else
            appliedText = _(" · updated — click Apply below")
        end
        table.insert(children, builtin.TextView{
            meta = { class = "font-scale-annotation" },
            text = lang_util.format(
                _("data file: revision {revision} · {lines} lines · {force}{status}"),
                { revision = tostring(status.dataRevision), lines = tostring(status.dataLines),
                  force = forceText, status = appliedText }),
        })
    else
        table.insert(children, builtin.TextView{
            meta = { class = "font-scale-annotation" },
            text = _("data file not found (userdata/towns_industries/)"),
        })
    end
    if status.exportLines ~= nil then
        table.insert(children, builtin.TextView{
            meta = { class = "font-scale-annotation" },
            text = lang_util.format(
                _("export file: exported {count} lines"),
                { count = tostring(status.exportLines) }),
        })
    end

    table.insert(children, makeButtons())

    return builtin.BoxLayout{
        orientation = builtin.type.Orientation.Vertical,
        children = children,
    }
end

local record AutoFillWindowParams
    onClose : function()
end

local AutoFillWindowContent = react.RegisterRecipe(
    "AutoFillWindowContent",
    function(_params : AutoFillWindowParams) : TreeNodeId
        local statusState = engine_react_util.useStepStateTimer(function() : StatusSnap
            return buildStatus()
        end, 1.0)
        local statusNow : StatusSnap | nil = statusState:old()
        local status : StatusSnap
        if statusNow == nil then
            status = {
                dataFound = false,
                dataRevision = nil,
                dataLines = nil,
                dataForce = nil,
                exportLines = nil,
                appliedRevision = nil,
                report = nil,
            }
        else
            status = statusNow
        end
        return buildWindowContent(status)
    end)

local AutoFillWindow = react.RegisterWrapperRecipe(
    "AutoFillWindow",
    builtin.Window,
    function(params : AutoFillWindowParams) : TreeNodeId
        return builtin.Window{
            id = "tpf3.autofill.window",
            title = _("Timetable AutoFill Data Import"),
            onClose = params.onClose,
            closable = true,
            autoFocusOnBecomingVisible = true,
            content = AutoFillWindowContent(params),
        }
    end)

local function closeWindow()
    local winApi : any = windowApiInUse
    if winApi == nil then
        winApi = game_react_globals.getDefaultWindowApi()
    end
    if winApi ~= nil then
        (winApi as WindowApi).removeAllWindows(AutoFillWindow)
    end
    windowIsOpen = false
    windowApiInUse = nil
    debugPrint("[AFB-UI] window closed")
end

-- game-bar entry point ----------------------------------------------

local AutoFillBridge = react.RegisterPluginRecipe(
    game_bar_widgets.GameBarInfoDisplayExtension,
    "AutoFillBridge",
    function() : TreeNodeId
        -- Timer callbacks run in a restricted phase (parallel to render);
        -- hop to the main-thread join before touching file / command APIs.
        react.onStepTimer(function()
            react.enqueueJoin(function()
                local ok, err = pcall(poll)
                if not ok then
                    debugPrint("[AFB-UI] poll error: " .. tostring(err))
                end
            end, "AutoFillBridge:poll")
        end, POLL_SEC, false)

        return builtin.BoxLayout{
            orientation = builtin.type.Orientation.Horizontal,
            children = {
                builtin.Button{
                    meta = { class = "afb-gamebar-btn", tooltip = _("Timetable AutoFill") },
                    content = builtin.TextView{
                        meta = { class = "font-scale-headline" },
                        text = "AutoFill",
                    },
                    onClick = function()
                        if windowIsOpen then return end
                        local winApi : any = game_react_globals.getDefaultWindowApi()
                        if winApi == nil then return end
                        (winApi as WindowApi).addSingletonWindow(AutoFillWindow, {
                            onClose = closeWindow,
                        })
                        windowIsOpen = true
                        windowApiInUse = winApi
                        debugPrint("[AFB-UI] window opened")
                    end,
                },
            },
        }
    end)

return {
    AutoFillBridge = AutoFillBridge,
}
